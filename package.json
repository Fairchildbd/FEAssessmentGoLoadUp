{
  "name": "pet-sitting",
  "private": true,
  "type": "module",
  "description": "Pet-sitting booking app: a React web app and a React Native app sharing one TypeScript package.",
  "workspaces": [
    "shared",
    "web",
    "mobile"
  ],
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  },
  "scripts": {
    "web": "npm run dev --workspace @pet-sitting/web",
    "mobile": "npm run start --workspace @pet-sitting/mobile",
    "ios": "npm run ios --workspace @pet-sitting/mobile",
    "android": "npm run android --workspace @pet-sitting/mobile",
    "build": "npm run build --workspace @pet-sitting/web",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace @pet-sitting/web",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
